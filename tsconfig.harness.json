{
  // Everything that is typechecked but never shipped: the local dev stack, the
  // Playwright end-to-end specs and their config, and the Vitest unit tests.
  //
  // These import devDependencies (`pg`, `@playwright/test`, `vitest`), so they
  // are kept out of `tsconfig.json` — `next build` runs that program, and a
  // build from an install without devDependencies would otherwise fail on
  // harness files alone. `npm run typecheck` runs both configs, so nothing here
  // loses its type coverage.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./tsconfig.harness.tsbuildinfo",
    // Node scripts, not browser code.
    "module": "esnext",
    "moduleResolution": "bundler"
  },
  "include": [
    "scripts/**/*.ts",
    "scripts/**/*.mts",
    "e2e/**/*.ts",
    "playwright.config.ts",
    "vitest.config.mts",
    "**/*.test.ts",
    "**/*.test.tsx",
    "lib/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
