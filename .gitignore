# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — real secrets live in .env.local, which is never committed.
# .env.example holds placeholder names only and IS committed.
.env*.local
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# supabase CLI local state
/supabase/.temp
/supabase/.branches

# local dev stack (scripts/dev-stack): throwaway database bytes, PostgREST
# config and uploaded objects. Never committed.
/.dev-stack/

# Playwright
/test-results/
/playwright-report/
/blob-report/
/e2e/screenshots/
