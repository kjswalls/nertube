# Copy to .env.local and fill in real values. .env.local is gitignored.

# Supabase project URL (e.g. http://127.0.0.1:54321 locally).
# `npm run dev:stack` prints ready-to-paste values for these first three — see
# scripts/dev-stack/README.md. That stack is a TEST harness, never production.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/publishable key. Safe for the browser; RLS is what protects data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key. Server-side only — never expose to the browser.
# Used by scripts/seed-demo.ts, not by the app.
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic API key for the brainstorm feature. Server-side only.
ANTHROPIC_API_KEY=

# Anthropic model id used by the brainstorm feature.
ANTHROPIC_MODEL=

# Which brainstorm provider answers: `fake` for the deterministic fixtures in
# lib/assist/fake.ts (no key, no network, what the e2e suite uses), anything
# else — including unset — for the real Anthropic call. Never `fake` in
# production: it would hand you invented titles as if a model wrote them.
ASSIST_PROVIDER=

# Credentials scripts/seed-demo.ts creates the single user with. Dev only —
# never point that script at production.
SEED_EMAIL=
SEED_PASSWORD=
