# Copy to .env.local and fill in real values. .env.local is gitignored.

# Supabase project URL (e.g. http://127.0.0.1:54321 locally).
# `npm run dev:stack` prints ready-to-paste values for these first three — see
# scripts/dev-stack/README.md. That stack is a TEST harness, never production.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/publishable key. Safe for the browser; RLS is what protects data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key. Server-side only — never expose to the browser.
# Used by scripts/seed-demo.ts, not by the app.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# The brainstorm. README.md ("Which assist implementation answers", under
# "Environment variables") has the full table; this is the short version.
# ---------------------------------------------------------------------------

# Anthropic API key. SERVER-SIDE ONLY — no NEXT_PUBLIC_ prefix, ever, because
# that prefix is exactly what inlines a value into the browser bundle.
# lib/assist/anthropic.ts is the only file that reads it, and it imports
# "server-only" so a client component that reached it fails the build.
# This is the one variable you must set in Vercel for the real provider.
ANTHROPIC_API_KEY=

# Anthropic model id. Optional: unset uses the id pinned in
# lib/assist/anthropic.ts. Set it to migrate models without shipping code.
ANTHROPIC_MODEL=

# Which implementation answers. `fake` forces the deterministic fixtures in
# lib/assist/fake.ts (no key, no network — what the Playwright suite uses).
# `manual` (M11) makes "Open in Claude" every assist's only action: the app
# writes the prompt, you run it in your own claude.ai conversation and paste
# the reply back. Nothing is asked of the API, key or no key: the API actions
# themselves refuse every request while this is set.
#
# Unset with no key is Open in Claude too, in every environment — so a
# deployment without a key costs nothing and still works. Unset with a key
# means the API answers, with Open in Claude one press away. Any other
# non-empty value means the API.
#
# LEAVE THIS UNSET IN PRODUCTION (or `manual`). A `fake` in production would
# hand you invented titles and let you believe a model wrote them. The full
# rule, with a unit test per case, is lib/assist/select.ts
# (`selectAssistMode`, then `selectAssistProvider`).
ASSIST_PROVIDER=

# Dev and test only: makes the fixtures answer with a named failure
# ("refused", "timeout", "rate_limited", …) so the error paths can be walked.
# Read by lib/assist/fake.ts and by nothing else. Never set in production.
ASSIST_FAKE_SCENARIO=

# Credentials scripts/seed-demo.ts creates the single user with. Dev only —
# never point that script at production.
SEED_EMAIL=
SEED_PASSWORD=
